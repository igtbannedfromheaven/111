local HOVER_HEIGHT = 8.2
dungeonSection:Slider("Height above mob", HOVER_HEIGHT, 1, 5, 20, "studs", function(v) HOVER_HEIGHT = v; autoSave() end)
dungeonSection:Button("Force Refresh (Teleport to Mob)", function()
    local dungeonStorage = Workspace:FindFirstChild("DungeonStorage")
    if not dungeonStorage then return end
    local player = Players.LocalPlayer
    local char = player and player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local closest = nil
    local minDist = math.huge
    local function scan(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("Model") then
                local hrp = child:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (root.Position - hrp.Position).Magnitude
                    if dist < minDist then minDist = dist; closest = hrp end
                end
            end
            scan(child)
        end
    end
    pcall(function() scan(dungeonStorage) end)
    if closest then
        local pos = closest.Position + Vector3.new(0, HOVER_HEIGHT, 0)
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(pos.X, pos.Y, pos.Z)
        end)
    end
end)

