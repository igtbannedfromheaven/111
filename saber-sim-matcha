local function getPlayerHRP()
    local player = Players.LocalPlayer
    if not player then return nil end
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function formatTime(seconds)
    if seconds <= 0 then return "Ready" end
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%d:%02d", mins, secs)
end

local function getDungeonCooldownRemaining()
    local elapsed = os.time() - lastDungeonTime
    local remaining = dungeonCooldown - elapsed
    return remaining > 0 and remaining or 0
end

local function expandSingleBoss(bd, multiplier)
    if bd.model and bd.model.Parent and isAlive(bd.model) then return end
    if bd.model then
        local hrp = bd.model:FindFirstChild("HumanoidRootPart")
        safeModify(hrp, bd.origSize, bd.origTransp)
        bd.model = nil
    end
    local boss = findByParts(bd.parts)
    if not boss or not boss:IsA("Model") or not isAlive(boss) then return end
    local hrp = boss:FindFirstChild("HumanoidRootPart")
    if not hrp or not hrp:IsA("BasePart") then return end
    bd.origSize = hrp.Size
    bd.origTransp = hrp.Transparency
    bd.model = boss
    safeModify(hrp, bd.origSize * multiplier, 1)
end

local function expandGolems(zoneData)
    local zone = findByParts(zoneData.zoneParts)
    if not zone then
        for _, data in pairs(zoneData.activeGolems) do
            safeModify(data.hrp, data.origSize, data.origTransparency)
        end
        zoneData.activeGolems = {}
        return
    end

    local currentGolems = {}
    for _, child in ipairs(zone:GetChildren()) do
        if child.Name == zoneData.golemName and child:IsA("Model") and isAlive(child) then
            currentGolems[child] = true
            if not zoneData.activeGolems[child] then
                local hrp = child:FindFirstChild("HumanoidRootPart")
                if hrp and hrp:IsA("BasePart") then
                    local origSize = hrp.Size
                    local origTransp = hrp.Transparency
                    safeModify(hrp, origSize * BOSS_MULT, 1)
                    zoneData.activeGolems[child] = { hrp = hrp, origSize = origSize, origTransparency = origTransp }
                end
            end
        end
    end

    local toRemove = {}
    for model, data in pairs(zoneData.activeGolems) do
        if not currentGolems[model] then table.insert(toRemove, model) end
    end
    for _, model in ipairs(toRemove) do
        local data = zoneData.activeGolems[model]
        if data then
            safeModify(data.hrp, data.origSize, data.origTransparency)
            zoneData.activeGolems[model] = nil
        end
    end
end

local function expandAllGolems()
    local enabledMap = {
        fireGolems = {1, 2},
        waterGolems = {3, 4, 5},
        earthGolems = {6, 7, 8},
        plasmaGolems = {9, 10, 11}
    }
    for targetName, indices in pairs(enabledMap) do
        if targets[targetName].enabled then
            for _, idx in ipairs(indices) do
                expandGolems(golemZones[idx])
            end
        else
            for _, idx in ipairs(indices) do
                for _, data in pairs(golemZones[idx].activeGolems) do
                    safeModify(data.hrp, data.origSize, data.origTransparency)
                end
                golemZones[idx].activeGolems = {}
            end
        end
    end
end

local function lightResetBossCache()
