local function startDungeon()
    local remaining = getDungeonCooldownRemaining()
    if remaining > 0 then return false, "cooldown", remaining end
    local success = pcall(function() UIAction:FireServer("SetRegionLoaded", "Dungeon Lobby") end)
    if not success then return false, "error" end
    task.wait(1)
    pcall(function() UIAction:FireServer("DungeonGroupAction", "Create", "Public", "Space", dungeonDifficulty) end)
    task.wait(0.5)
    pcall(function() UIAction:FireServer("DungeonGroupAction", "Start") end)
    lastDungeonTime = os.time()
    return true, "ok"
end

